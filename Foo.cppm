        wl_resource_post_error(pResource, error, "%s", message.c_str());
    }


    void noMemory() {
        wl_resource_post_no_memory(pResource);
    }


    int version() {
        return wl_resource_get_version(pResource);
    }



    void setDestroy(std::function<void(CWpContentTypeManagerV1*)> handler);
    void setGetSurfaceContentType(std::function<void(CWpContentTypeManagerV1*, uint32_t, wl_resource*)> handler);




  private:
